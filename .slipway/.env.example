# Seed file for the secrets slipway consumes locally: copy to .slipway/.env (gitignored; chmod 600) and fill the values.
# The plugin only ever *sources* this file into a shell command (`set -a; . .slipway/.env; set +a`) so the values become
# environment variables for `gh secret set`, `docker login` and friends; the guard hook refuses to print or read it.
# Alternative without a file: keep the value in the clipboard and let the agent run `gh secret set NAME --body "$(pbpaste)"`.

# Docker Hub account with access to Docker Hardened Images (dhi.io): username (variable) and an access token (secret).
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Optional: pin the Azure subscription and tenant for local az/terraform commands instead of `az account set`.
# ARM_SUBSCRIPTION_ID=
# ARM_TENANT_ID=

# Runtime secrets of app `api` (apps[].secrets): after the foundation apply the agent writes each one to Key Vault
# from this file, behind a permission prompt: set -a; . .slipway/.env; set +a; az keyvault secret set --vault-name kv-taskflow-d1 --name <secret> --value "$VAR"
DATABASE_URL=
