{
  "name": "taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "Personal task API — lists, tasks, due dates",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://taskflow:taskflow@localhost:5432/taskflow_test} vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
